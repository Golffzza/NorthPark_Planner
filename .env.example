DATABASE_URL="postgresql://postgres:postgres@localhost:5432/northpark_planner?schema=public"
# Optional for Phase 2 LINE MINI App / LIFF shell. Leave empty to keep the app usable in a normal browser.
NEXT_PUBLIC_LIFF_ID=""
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
SESSION_SECRET=""
SESSION_COOKIE_NAME="northpark_session"
USE_MOCK_AUTH="true"
OPEN_METEO_BASE_URL="https://api.open-meteo.com"
APP_TIMEZONE="Asia/Bangkok"
OSRM_BASE_URL="http://router.project-osrm.org"
USE_PUBLIC_OSRM="true"

# NorthPark Assistant — Conversation Core

CHATBOT_PROVIDER="ollama"
OLLAMA_EMBEDDING_MODEL="embeddinggemma"

OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="northpark-qwen"

OLLAMA_REQUEST_TIMEOUT_MS="60000"
OLLAMA_NUM_CTX="8192"
OLLAMA_NUM_PREDICT="256"
OLLAMA_KEEP_ALIVE="30m"
OLLAMA_WARMUP_TIMEOUT_MS="60000"
OLLAMA_WARMUP_RETRY_MS="30000"
OLLAMA_EMBEDDING_TIMEOUT_MS="15000"
OLLAMA_EMBEDDING_KEEP_ALIVE="1m"
ASSISTANT_TURN_TIMEOUT_MS="45000"
ASSISTANT_COMPOSE_TIMEOUT_MS="3500"
ASSISTANT_COMPOSE_NUM_PREDICT="64"
ASSISTANT_INTENT_TIMEOUT_MS="2500"
ASSISTANT_INTENT_FALLBACK_MIN_CONFIDENCE="0.65"

CHATBOT_MAX_MESSAGE_LENGTH="1000"
CHATBOT_MAX_HISTORY_MESSAGES="16"
CHATBOT_CONVERSATION_TTL_MS="1800000"

# =========================
# RAG Retrieval
# =========================

RAG_RESULT_LIMIT="5"
RAG_VECTOR_CANDIDATE_LIMIT="60"
RAG_MAX_CHUNKS_PER_PARK="2"
CHATBOT_RAG_RESULT_LIMIT="4"
CHATBOT_RAG_CHUNK_MAX_CHARS="900"
CHATBOT_RAG_HISTORY_USER_TURNS="2"

# Intent routing is hybrid: deterministic rules first, then the warm Ollama
# analyzer only for messages that rules cannot classify. RAG query analysis
# remains local; the legacy KnowledgeQueryAnalyzer is not called per message.

# =========================
# Ranking
# =========================

RAG_ACTIVITY_MATCH_WEIGHT="0.14"
RAG_ACTIVITY_MISMATCH_PENALTY="0.05"
RAG_ACTIVITY_CONTEXT_PENALTY="0.025"

RAG_TAG_MATCH_WEIGHT="0.035"
RAG_TAG_MATCH_MAX="0.105"

RAG_EFFORT_EXACT_WEIGHT="0.10"
RAG_EFFORT_ADJACENT_WEIGHT="0.04"
RAG_EFFORT_DISTANCE_PENALTY="0.04"

RAG_PREPARATORY_PENALTY="0.18"

RAG_ATTRACTION_SECTION_WEIGHT="0.025"
RAG_SUITABILITY_SECTION_WEIGHT="0.02"
RAG_ITINERARY_SECTION_WEIGHT="0.01"
RAG_DYNAMIC_SECTION_WEIGHT="0.16"

RAG_EXACT_ENTITY_WEIGHT="0.16"

RAG_LOW_EFFORT_WALKING_KM="1.5"
RAG_LONG_WALK_PENALTY="0.07"

# semantic backup สำหรับ dynamic/live query
RAG_DYNAMIC_LIVE_MIN_SIMILARITY="0.30"
