generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum Region {
  NORTH
}

enum AttractionType {
  VIEWPOINT
  WATERFALL
  TRAIL
  CAMPSITE
  OTHER
}

enum WarningSeverity {
  LOW
  MEDIUM
  HIGH
}

enum TransportMode {
  CAR
  MOTORCYCLE
  PUBLIC_TRANSPORT
  OTHER
}

enum TripStatus {
  DRAFT
  EVALUATED
  CANCELLED
  COMPLETED
}

enum EvaluationLevel {
  EXCELLENT
  GOOD
  MODERATE
  NEEDS_ADJUSTMENT
}

enum WeatherCondition {
  CLEAR
  CLOUDY
  LIGHT_RAIN
  HEAVY_RAIN
  STORM
}

enum ParkEvidenceKind {
  ENTRANCE
  SCHEDULE
  PERMISSION
  LAST_MILE
}

enum ParkEvidenceAction {
  SUBMITTED
  APPROVED
  REJECTED
  REVOKED
}

model User {
  id          String   @id @default(cuid())
  lineUserId  String?  @unique
  displayName String
  email       String?  @unique
  phone       String?
  role        UserRole @default(USER)
  lineAccount LineAccount?
  sessions    UserSession[]
  trips       Trip[]
  evidenceRevisions ParkEvidenceRevision[] @relation("EvidenceRecordedBy")
  evidenceAuditEvents ParkEvidenceAuditEvent[] @relation("EvidenceActor")
  evidenceAuthorities ParkEvidenceAuthority[] @relation("EvidenceAuthorityUser")
  evidenceGrants ParkEvidenceAuthority[] @relation("EvidenceAuthorityGrantor")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([role])
  @@index([createdAt])
}

model LineAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lineUserId    String   @unique
  displayName   String
  pictureUrl    String?
  statusMessage String?
  language      String?
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
}

model Park {
  id            String           @id @default(cuid())
  slug          String           @unique
  nameTh        String
  nameEn        String?
  province      String
  region        Region           @default(NORTH)
  latitude      Decimal?         @db.Decimal(9, 6)
  longitude     Decimal?         @db.Decimal(9, 6)
  openTime      String
  closeTime     String
  description   String
  coverImageUrl String?
  isActive      Boolean          @default(true)
  attractions   ParkAttraction[]
  warnings      ParkWarning[]
  evidenceRevisions ParkEvidenceRevision[]
  evidenceAuthorities ParkEvidenceAuthority[]
  trips         Trip[]
  knowledgeDocuments KnowledgeDocument[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([province])
  @@index([region, isActive])
  @@index([isActive, createdAt])
}

model ParkAttraction {
  id          String         @id @default(cuid())
  parkId      String
  park        Park           @relation(fields: [parkId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        AttractionType
  imageUrl    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([parkId])
  @@index([parkId, type])
}

model ParkWarning {
  id          String          @id @default(cuid())
  parkId      String
  park        Park            @relation(fields: [parkId], references: [id], onDelete: Cascade)
  title       String
  description String
  severity    WarningSeverity
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([parkId])
  @@index([parkId, isActive])
  @@index([parkId, severity])
}

model Trip {
  id                     String           @id @default(cuid())
    aiDraftId              String?          @unique
  userId                 String
  user                   User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  parkId                 String
  park                   Park             @relation(fields: [parkId], references: [id], onDelete: Restrict)
    tripDate               DateTime?
    departAt               String?
    originText             String?
  originLat              Decimal?         @db.Decimal(9, 6)
  originLng              Decimal?         @db.Decimal(9, 6)
    transportMode          TransportMode?
    travelerCount          Int?
    weatherCondition       WeatherCondition?
    estimatedTravelMinutes Int?
  mockSunsetTime         String?
  notes                  String?
  status                 TripStatus       @default(DRAFT)
  evaluations            TripEvaluation[]
  weatherSnapshots       WeatherSnapshot[]
  sunsetSnapshots        SunsetSnapshot[]
  routeSnapshots         RouteSnapshot[]
    itineraryDays          TripItineraryDay[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([userId])
  @@index([parkId])
  @@index([status])
  @@index([userId, createdAt])
  @@index([userId, tripDate])
}

model TripItineraryDay {
  id        String              @id @default(cuid())
  tripId    String
  trip      Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayNumber Int
  title     String
  notes     String?
  items     TripItineraryItem[]

  @@unique([tripId, dayNumber])
  @@index([tripId])
}

model TripItineraryItem {
  id              String           @id @default(cuid())
  dayId           String
  day             TripItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  position        Int
  name            String
  sourceReference String?
  notes           String?

  @@unique([dayId, position])
  @@index([dayId])
}

model TripEvaluation {
  id               String          @id @default(cuid())
  tripId           String
  trip             Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  weatherSnapshotId String?
  routeSnapshotId   String?
  sunsetSnapshotId  String?
  weatherSnapshot   WeatherSnapshot? @relation(fields: [weatherSnapshotId], references: [id], onDelete: Restrict)
  routeSnapshot     RouteSnapshot?   @relation(fields: [routeSnapshotId], references: [id], onDelete: Restrict)
  sunsetSnapshot    SunsetSnapshot?  @relation(fields: [sunsetSnapshotId], references: [id], onDelete: Restrict)

  totalScore       Int
  level            EvaluationLevel

  weatherScore     Int
  durationScore    Int
  timeScore        Int

  // ชื่อเดิมเก็บไว้เพื่อ compatibility
  // ปัจจุบันใช้แทนคะแนนด้าน transport/accessibility
  userProfileScore Int

  // ถ้ามี hard constraint เช่นไปถึงหลังอุทยานปิด จะเป็น false
  canProceed       Boolean         @default(true)

  // รายละเอียดคะแนน + reason ของแต่ละ factor
  factors          Json?

  // hard constraints / warnings เชิงโครงสร้าง
  constraints      Json?

  summary          String
  recommendation   String

  explanationHeadline String?
  explanationText     String?

  evaluatedAt      DateTime
  createdAt        DateTime        @default(now())

  @@index([tripId])
  @@index([tripId, createdAt])
  @@index([level])
  @@index([weatherSnapshotId])
  @@index([routeSnapshotId])
  @@index([sunsetSnapshotId])
}

model WeatherSnapshot {
  id               String           @id @default(cuid())
  tripId           String
  trip             Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  evaluations      TripEvaluation[]
  source           String
  timezone         String
  latitude         Decimal          @db.Decimal(9, 6)
  longitude        Decimal          @db.Decimal(9, 6)
  forecastAt       DateTime
  weatherCode      Int
  precipitationMm  Float?
  weatherCondition WeatherCondition
  temperatureC     Float?
  windSpeedKmh     Float?
  raw              Json
  createdAt        DateTime         @default(now())

  @@index([tripId])
  @@index([tripId, createdAt])
  @@index([weatherCondition])
}

model SunsetSnapshot {
  id              String   @id @default(cuid())
  tripId          String
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  evaluations     TripEvaluation[]
  source          String
  timezone        String
  latitude        Decimal  @db.Decimal(9, 6)
  longitude       Decimal  @db.Decimal(9, 6)
  sunsetAt        DateTime
  sunsetLocalTime String
  createdAt       DateTime @default(now())

  @@index([tripId])
  @@index([tripId, createdAt])
}

model RouteSnapshot {
  id                 String   @id @default(cuid())
  tripId             String
  trip               Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  evaluations        TripEvaluation[]
  source             String
  originLat          Decimal  @db.Decimal(9, 6)
  originLng          Decimal  @db.Decimal(9, 6)
  destinationLat     Decimal  @db.Decimal(9, 6)
  destinationLng     Decimal  @db.Decimal(9, 6)
  distanceMeters     Float
  durationSeconds    Float
  geometryJson       Json?
  rawJson            Json?
  createdAt          DateTime @default(now())

  @@index([tripId])
  @@index([tripId, createdAt])
}

model EvaluationRule {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KnowledgeDocument {
  id              String   @id
  sourceType      String
  sourceEntityId  String
  parkId          String
  park            Park     @relation(fields: [parkId], references: [id], onDelete: Cascade)
  title           String
  contentHash     String
  sourceUpdatedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  chunks KnowledgeChunk[]

  @@unique([sourceType, sourceEntityId])
  @@index([sourceEntityId])
  @@index([parkId])
}

model KnowledgeChunk {
  id          String @id
  documentId  String
  title       String
  section     String
  content     String
  contentHash String
  ordinal     Int

  embedding Unsupported("vector(768)")

  createdAt DateTime @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([documentId])
}

/** E5.3: additive, candidate-only registry. Do not backfill Park center/hours as verified. */
model ParkEvidenceRevision {
  id String @id @default(cuid())
  parkId String
  park Park @relation(fields: [parkId], references: [id], onDelete: Restrict)
  kind ParkEvidenceKind
  entityKey String
  payload Json
  supersedesId String? @unique
  supersedes ParkEvidenceRevision? @relation("EvidenceRevisionChain", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy ParkEvidenceRevision? @relation("EvidenceRevisionChain")
  recordedById String
  recordedBy User @relation("EvidenceRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  recordedAt DateTime @default(now())
  auditEvents ParkEvidenceAuditEvent[]

  @@index([parkId, kind, entityKey])
  @@index([parkId, recordedAt])
}

model ParkEvidenceAuditEvent {
  id String @id @default(cuid())
  revisionId String
  revision ParkEvidenceRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  actorUserId String
  actor User @relation("EvidenceActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  action ParkEvidenceAction
  occurredAt DateTime @default(now())
  note String

  @@index([revisionId, occurredAt, id])
  @@index([actorUserId, occurredAt])
}

model ParkEvidenceAuthority {
  id String @id @default(cuid())
  userId String
  user User @relation("EvidenceAuthorityUser", fields: [userId], references: [id], onDelete: Restrict)
  parkId String
  park Park @relation(fields: [parkId], references: [id], onDelete: Restrict)
  canReview Boolean @default(false)
  effectiveFrom DateTime
  effectiveTo DateTime
  grantedById String
  grantedBy User @relation("EvidenceAuthorityGrantor", fields: [grantedById], references: [id], onDelete: Restrict)
  grantedAt DateTime @default(now())

  @@index([userId, parkId, effectiveFrom, effectiveTo])
  @@index([parkId, canReview])
}
